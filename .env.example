# SQLite database (relative to the prisma/ directory)
DATABASE_URL="file:../data/gallery.db"

# Auth.js — generate with: openssl rand -base64 32 (at least 32 characters)
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
# Set true only behind a reverse proxy that overwrites Host / X-Forwarded-*
AUTH_TRUST_HOST="true"

# Seeded on first boot if no user with this email exists.
# Password must be at least 12 characters. Changing ADMIN_PASSWORD later does not update an existing hash.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional storage quota (bytes). Default: 10 GB
STORAGE_QUOTA_BYTES="10737418240"
