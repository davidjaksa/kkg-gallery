generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  EDITOR
  ADMIN
}

enum PhotoStatus {
  PROCESSING
  READY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  albums       Album[]
  photos       Photo[]
}

model Album {
  id          String    @id @default(cuid())
  slug        String
  title       String
  description String?
  eventDate   DateTime?
  published   Boolean   @default(false)
  sortOrder   Int       @default(0)
  coverPath   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  parentId    String?
  parentKey   String    @default("")
  parent      Album?    @relation("AlbumTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Album[]   @relation("AlbumTree")
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  photos      Photo[]

  @@unique([parentKey, slug])
  @@index([parentId])
}

model Photo {
  id           String      @id @default(cuid())
  filename     String
  originalPath String
  displayPath  String
  thumbPath    String
  contentHash  String?
  status       PhotoStatus @default(PROCESSING)
  createdAt    DateTime    @default(now())
  albumId      String
  album        Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User        @relation(fields: [uploadedById], references: [id])

  @@index([contentHash])
}

model Setting {
  key   String @id
  value String
}
